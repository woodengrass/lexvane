{
  "schema_version": 4,
  "policy_version": "baseline-5",
  "product": {
    "_note": "產品規則：使用者看得到的行為，必須遵守；數值可在 beta 後調整，但程式要能不改碼就調整。",
    "self_rating_enabled": false,
    "use_latency_for_rating": false,
    "case_sensitive_grading": false,
    "automatic_enrollment": false,
    "lookup_alone_changes_grade": false,
    "typing_window": 20,
    "ordinary_typing_max": 2,
    "study_day_start_hour": 4,
    "initial_budget_example_minutes": 15,
    "exclude_background_time": true,
    "lookup": {
      "prompt_distinct_dates": 3,
      "window_days": 14,
      "dismissal_cooldown_days": 30,
      "history_retention_days": 90,
      "entry_open_only": true
    },
    "automatic_budget_increase": false,
    "parallel_exam_budgets": false,
    "scope_reduction_changes_scoring": false,
    "original_exam_scope_is_progress_denominator": true,
    "due_review_backlog_is_not_mandatory_daily_work": true,
    "unseen_contextual_exam_performance_is_primary_outcome": true,
    "desired_retention_is_product_outcome": false,
    "one_presentation_max_independent_primary_grade": 1,
    "individual_parameters_stay_on_device": true,
    "individual_fit_requires_sufficient_local_data": true,
    "individual_fit_requires_heldout_improvement": true,
    "individual_fit_must_avoid_abrupt_rescheduling": true,
    "memory_model_conformance_tests_required": true,
    "simulation_acceptance": {
      "planned_next_activity_must_fit_estimated_remaining_time": true,
      "actual_time_overrun_from_finishing_started_item_allowed": true,
      "report_actual_time_overrun_distribution": true,
      "compare_delayed_progress_and_new_coverage_at_equal_actual_time": true,
      "no_exam_must_not_pass_by_avoiding_new_learning": true,
      "exam_scope_denominator_must_not_shrink": true,
      "partial_sessions_missed_days_and_changed_budget_required": true,
      "meaningful_progress_under_partial_sessions_required": true,
      "deterministic": true,
      "compare_to_fair_simple_baseline": true,
      "allow_optional_advanced_strategy_disabled_without_evidence": true,
      "original_scope_includes_unsupported_confirmed_items": true
    },
    "daily_budget_is_estimated_target_not_forced_stop": true,
    "normal_daily_budget_is_editable": true,
    "today_only_budget_override_resets_next_study_day": true,
    "complete_started_item_or_allow_voluntary_pause": true,
    "do_not_auto_change_budget_from_usage": true,
    "prolonged_underuse_reminder_even_without_exam": true,
    "underuse_reminder_can_be_dismissed_or_deferred": true,
    "stale_presentation_after_inactive_hours": 72,
    "stale_presentation_replacement_must_not_grade_unanswered_item": true,
    "opening_old_question_alone_does_not_extend_expiry": true,
    "old_draft_submission_cannot_fabricate_delayed_recall": true,
    "initial_memory_model_baseline": "FSRS-6 (21 parameters, S09)",
    "initial_baseline_grading_adapter": {
      "correct_independent": 3,
      "incorrect_independent": 1
    },
    "pre_answer_solve_hints_enabled": false,
    "post_answer_correct_explanation_required": true,
    "grade_mapping_versioned_and_replayable": true,
    "unscored_exposure_cannot_count_as_success_or_failure": true,
    "explicit_primary_target_and_tested_ability_required": true,
    "fixed_or_simple_retention_allowed_until_advanced_strategy_validated": true,
    "dynamic_retention_requires_comparison_before_default": true,
    "individual_parameter_refitting_not_required_for_core_release": true,
    "official_ceec_wordlist_complete_learnable_coverage_required_for_v1": true,
    "user_confirmed_unlisted_exam_terms_remain_in_scope_denominator": true,
    "missing_word_report_requires_explicit_per_item_preview_and_consent": true,
    "content_report_cannot_share_research_consent": true,
    "early_small_human_pilot_before_mass_content": true,
    "validated_simple_baseline_must_remain_available": true
  },
  "reference_starting_points": {
    "_note": "可參考的起始值，不是要求；實作可替換，替換時記錄理由。說明見 docs/08「可參考的做法」。",
    "memory": {
      "initial_desired_retention": 0.9,
      "retention_bounds": [
        0.7,
        0.95
      ],
      "retention_reselect_days": 7,
      "retention_max_change_per_reselect": 0.05,
      "long_horizon_days": 90,
      "delayed_min_seconds": 86400,
      "intervening_distinct_targets": 3,
      "reanchor_validation_max_days": 7,
      "optional_param_update_mean_schedule_change_reference": 0.1,
      "optional_param_update_max_schedule_change_reference": 0.2
    },
    "evidence": {
      "foundation": {
        "unaided_successes": 2,
        "distinct_families": 2,
        "delayed_successes": 1
      },
      "stable": {
        "delayed_successes": 3,
        "distinct_study_dates": 3,
        "required_long_lag_days": 7,
        "unseen_check_family_required": true
      }
    },
    "interaction": {
      "short_passage_words": [
        50,
        100
      ],
      "short_passage_items": [
        2,
        3
      ]
    },
    "time": {
      "uncertain_inactivity_seconds": 120,
      "underuse_observation_days": 14,
      "underuse_reminder_cooldown_days": 14,
      "underuse_gap_fraction_for_review": 0.5
    },
    "cost": {
      "shrinkage_prior_strength": 30,
      "max_recent_samples_per_bucket": 200,
      "planning_quantile": 0.75,
      "seed_seconds": {
        "teaching": 15,
        "sentence_choice": 12,
        "slot_choice": 10,
        "typed_recall": 20,
        "feedback": 5,
        "passage_reading": 45
      }
    },
    "planner": {
      "high_risk_margin_below_target": 0.1,
      "maintenance_share_cap_with_uncovered_scope": 0.7,
      "admission_horizon_days": 14,
      "admission_max_projected_review_share": 0.85,
      "diagnostic_share_cap": 0.1,
      "max_scored_remediation_attempts_per_target_per_day": 3,
      "simulation_trajectories": 32,
      "min_horizon_days": 14,
      "max_detailed_horizon_days": 90
    }
  }
}
